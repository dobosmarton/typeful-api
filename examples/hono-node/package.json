{
  "name": "hono-node-example",
  "version": "0.0.1",
  "private": true,
  "description": "Hono + Node.js example using typeful-api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --dts",
    "generate": "pnpm generate:spec && pnpm generate:client",
    "generate:spec": "typeful-api generate-spec --contract ./src/api.ts --out ./openapi.json --title 'Hono Node.js Example API' --api-version '1.0.0'",
    "generate:client": "typeful-api generate-client --spec ./openapi.json --out ./src/api.generated.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@typeful-api/core": "workspace:*",
    "@typeful-api/hono": "workspace:*",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@typeful-api/cli": "workspace:*",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
