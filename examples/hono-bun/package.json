{
  "name": "hono-bun-example",
  "version": "0.0.1",
  "private": true,
  "description": "Hono + Bun example using typeful-api",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "generate": "pnpm generate:spec && pnpm generate:client",
    "generate:spec": "typeful-api generate-spec --contract ./src/api.ts --out ./openapi.json --title 'Hono Bun Example API' --api-version '1.0.0'",
    "generate:client": "typeful-api generate-client --spec ./openapi.json --out ./src/api.generated.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@typeful-api/core": "workspace:*",
    "@typeful-api/hono": "workspace:*",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@typeful-api/cli": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
