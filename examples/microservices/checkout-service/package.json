{
  "name": "@example/checkout-service",
  "version": "0.0.1",
  "private": true,
  "description": "Checkout service (Express): calls the orders service through a client generated from its /api-doc",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "generate:clients": "typeful-api generate-client",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typeful-api/core": "workspace:*",
    "@typeful-api/express": "workspace:*",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@typeful-api/cli": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
