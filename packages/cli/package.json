{
  "name": "@typeful-api/cli",
  "version": "0.1.1",
  "description": "CLI for generating OpenAPI specs and client types from typeful-api contracts",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "typeful-api": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@typeful-api/core": "workspace:*",
    "cac": "^7.1.0",
    "jiti": "^2.7.0",
    "openapi-typescript": "^7.13.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "keywords": [
    "openapi",
    "typescript",
    "cli",
    "codegen",
    "typesafe"
  ],
  "author": "Marton Dobos",
  "license": "MIT",
  "homepage": "https://github.com/dobosmarton/typeful-api#readme",
  "bugs": {
    "url": "https://github.com/dobosmarton/typeful-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dobosmarton/typeful-api.git",
    "directory": "packages/cli"
  }
}
