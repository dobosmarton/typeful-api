{
  "name": "@typeful-api/core",
  "version": "0.2.0",
  "description": "Framework-agnostic core for typesafe OpenAPI-first APIs",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "zod": ">=4.0.0"
  },
  "keywords": [
    "openapi",
    "typescript",
    "zod",
    "api",
    "typesafe",
    "rest"
  ],
  "author": "Marton Dobos",
  "license": "MIT",
  "homepage": "https://github.com/dobosmarton/typeful-api#readme",
  "bugs": {
    "url": "https://github.com/dobosmarton/typeful-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dobosmarton/typeful-api.git",
    "directory": "packages/core"
  }
}
